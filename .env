# Copy to `.env` in this folder (storefront).
#
# Prerequisite: brandflow-admin backend running with Neon + CORS configured.
# Backend env lives in `brandflow-admin/backend/.env` — see that repo's `.env.example`
# for DATABASE_URL, PORT=3001, CORS_ORIGIN (must include this app's dev origin).

# Brandflow Admin API (no trailing slash)
VITE_API_URL= https://brandflow-admin.onrender.com/api

# This Vite app runs on http://localhost:8080 by default (see vite.config.ts).
# Ensure backend CORS_ORIGIN includes: http://localhost:8080

# Optional — real Razorpay checkout (demo key used if unset)
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxx
